# Docker Compose environment. Copy to .env for local overrides.
# Application secrets belong in apps/api/.env — never commit real values.

POSTGRES_USER=sip
POSTGRES_PASSWORD=sip_dev_password
POSTGRES_DB=strategic_intelligence
POSTGRES_PORT=5432

NODE_ENV=development
API_PORT=3000
WEB_PORT=8080
RATE_LIMIT=120
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Session signing secrets — required. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-development-secret-1
JWT_REFRESH_SECRET=replace-me-with-a-long-random-development-secret-2
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# Must be true once the stack is served over HTTPS.
COOKIE_SECURE=false
