// Universal Strategic Intelligence Platform — initial data model (Sprint 0).
//
// Design rules (see docs/architecture.md and docs/database.md):
//   * Every tenant-owned table carries organizationId and is always queried through it.
//   * The core is industry-agnostic; industry specifics live in industry packs as data.
//   * Metric definitions are data, never code, and never hardcoded in the frontend.
//   * Money/metric values use Decimal, never Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 8.1 Identity
// ---------------------------------------------------------------------------

enum PlatformRole {
  PLATFORM_ADMIN
}

enum OrganizationRole {
  ORGANIZATION_ADMIN
  ANALYST
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  fullName     String
  status       UserStatus @default(ACTIVE)
  /// Null for ordinary users. Platform staff are separated from tenant membership.
  platformRole PlatformRole?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships       OrganizationUser[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  ownedGoals        Goal[]             @relation("GoalOwner")
  ownedDecisions    Decision[]         @relation("DecisionOwner")
  aiConversations   AiConversation[]

  @@index([status])
  @@map("users")
}

enum RefreshTokenRevocationReason {
  ROTATED
  LOGOUT
  REUSE_DETECTED
  MEMBERSHIP_CHANGED
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// Only a hash of the refresh token is stored.
  tokenHash String    @unique
  /// All tokens rotated from one login share a family. Replaying a rotated token
  /// revokes the whole family, so a stolen token cannot outlive its detection.
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  revokedReason RefreshTokenRevocationReason?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OrganizationUser {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole
  isDefault      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_users")
}

// ---------------------------------------------------------------------------
// 8.2 Organization structure
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Industry {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizations Organization[]
  packs         IndustryPack[]
  metrics       Metric[]

  @@map("industries")
}

model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  slug         String             @unique
  industryId   String?            @db.Uuid
  countryCode  String             @db.VarChar(2)
  currencyCode String             @db.VarChar(3)
  timezone     String             @default("UTC")
  status       OrganizationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  industry Industry? @relation(fields: [industryId], references: [id])

  members       OrganizationUser[]
  branches      Branch[]
  departments   Department[]
  dataSources   DataSource[]
  datasets      Dataset[]
  dataImports   DataImport[]
  metrics       Metric[]
  metricValues  MetricValue[]
  metricTargets MetricTarget[]
  thresholds    MetricThreshold[]
  healthModels  HealthModel[]
  healthScores  HealthScore[]
  alertRules    AlertRule[]
  alerts        Alert[]
  insightRules  InsightRule[]
  insights      Insight[]
  goals         Goal[]
  decisions     Decision[]
  conversations AiConversation[]
  auditLogs     AuditLog[]
  settings      OrganizationSetting[]
  installedPacks OrganizationIndustryPack[]

  @@index([status])
  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  countryCode    String?  @db.VarChar(2)
  timezone       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]
  metricValues MetricValue[]
  healthScores HealthScore[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String?  @db.Uuid
  name           String
  code           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  metricValues MetricValue[]

  @@unique([organizationId, code])
  @@index([organizationId, branchId])
  @@map("departments")
}

// ---------------------------------------------------------------------------
// 8.3 Data management
// ---------------------------------------------------------------------------

enum DataSourceType {
  MANUAL
  CSV
}

enum DataSourceStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model DataSource {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  name           String
  type           DataSourceType
  status         DataSourceStatus @default(ACTIVE)
  lastSyncAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  datasets     Dataset[]
  imports      DataImport[]

  @@index([organizationId])
  @@map("data_sources")
}

model Dataset {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  dataSourceId   String?  @db.Uuid
  name           String
  code           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataSource   DataSource?     @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  columns      DatasetColumn[]
  imports      DataImport[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("datasets")
}

enum DatasetColumnType {
  STRING
  NUMBER
  DATE
  BOOLEAN
}

model DatasetColumn {
  id         String            @id @default(uuid()) @db.Uuid
  datasetId  String            @db.Uuid
  name       String
  code       String
  type       DatasetColumnType
  isRequired Boolean           @default(false)
  /// Optional unit hint used by import validation (e.g. CURRENCY, PERCENTAGE).
  unit       String?
  position   Int               @default(0)
  createdAt  DateTime          @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, code])
  @@map("dataset_columns")
}

enum ImportStatus {
  UPLOADED
  MAPPED
  VALIDATED
  COMMITTED
  FAILED
  CANCELLED
}

model DataImport {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  dataSourceId   String?      @db.Uuid
  datasetId      String?      @db.Uuid
  createdById    String?      @db.Uuid
  fileName       String
  fileSizeBytes  Int
  /// Checksum of the uploaded file — used to block duplicate commits.
  checksum       String
  status         ImportStatus @default(UPLOADED)
  /// Column mapping chosen by the user: source column -> dataset column / metric code.
  mapping        Json?
  rowsReceived   Int          @default(0)
  rowsValid      Int          @default(0)
  rowsWarning    Int          @default(0)
  rowsRejected   Int          @default(0)
  committedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataSource   DataSource?           @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  dataset      Dataset?              @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  rows         DataImportRow[]
  errors       DataValidationError[]

  @@unique([organizationId, checksum])
  @@index([organizationId, status])
  @@map("data_imports")
}

enum ImportRowStatus {
  VALID
  WARNING
  REJECTED
}

model DataImportRow {
  id           String          @id @default(uuid()) @db.Uuid
  dataImportId String          @db.Uuid
  rowNumber    Int
  /// Raw parsed row exactly as received — invalid data is never silently dropped.
  rawData      Json
  /// Normalised row after mapping and coercion; null when the row was rejected.
  parsedData   Json?
  status       ImportRowStatus @default(VALID)
  createdAt    DateTime        @default(now())

  dataImport DataImport            @relation(fields: [dataImportId], references: [id], onDelete: Cascade)
  errors     DataValidationError[]

  @@unique([dataImportId, rowNumber])
  @@index([dataImportId, status])
  @@map("data_import_rows")
}

enum ValidationSeverity {
  WARNING
  ERROR
}

model DataValidationError {
  id           String             @id @default(uuid()) @db.Uuid
  dataImportId String             @db.Uuid
  rowId        String?            @db.Uuid
  rowNumber    Int?
  column       String?
  code         String
  message      String
  severity     ValidationSeverity @default(ERROR)
  createdAt    DateTime           @default(now())

  dataImport DataImport     @relation(fields: [dataImportId], references: [id], onDelete: Cascade)
  row        DataImportRow? @relation(fields: [rowId], references: [id], onDelete: Cascade)

  @@index([dataImportId, severity])
  @@map("data_validation_errors")
}

// ---------------------------------------------------------------------------
// 8.4 Metrics
// ---------------------------------------------------------------------------

enum MetricUnit {
  CURRENCY
  PERCENTAGE
  COUNT
  DECIMAL
  RATIO
  DAYS
  HOURS
  MINUTES
  SCORE
}

enum MetricFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum MetricDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
  TARGET_RANGE
  INFORMATIONAL
}

enum AggregationType {
  SUM
  AVERAGE
  LAST
  MIN
  MAX
  FORMULA
}

model Metric {
  id              String          @id @default(uuid()) @db.Uuid
  /// Null for platform/industry template metrics; set for organization-owned metrics.
  organizationId  String?         @db.Uuid
  /// Set for industry template metrics.
  industryId      String?         @db.Uuid
  name            String
  code            String
  description     String?
  category        String?
  unit            MetricUnit
  aggregationType AggregationType
  frequency       MetricFrequency @default(MONTHLY)
  direction       MetricDirection @default(HIGHER_IS_BETTER)
  /// System metrics come from an industry pack and cannot be deleted by tenants.
  isSystem        Boolean         @default(false)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  industry     Industry?     @relation(fields: [industryId], references: [id], onDelete: Cascade)

  formula      MetricFormula?
  values       MetricValue[]
  targets      MetricTarget[]
  thresholds   MetricThreshold[]
  dependencies MetricDependency[] @relation("MetricDependent")
  dependents   MetricDependency[] @relation("MetricDependsOn")
  weights      HealthMetricWeight[]
  goalMetrics  GoalMetric[]
  alertRules   AlertRule[]
  alerts       Alert[]
  packMetrics  IndustryPackMetric[]
  decisionMetrics DecisionMetric[]

  @@unique([organizationId, code])
  @@unique([industryId, code])
  @@index([organizationId, isActive])
  @@map("metrics")
}

model MetricFormula {
  id         String   @id @default(uuid()) @db.Uuid
  metricId   String   @unique @db.Uuid
  /// Expression over other metric codes, e.g. "net_profit / revenue * 100".
  expression String
  /// Ordered metric codes referenced by the expression (denormalised for validation).
  inputs     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  metric Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@map("metric_formulas")
}

model MetricDependency {
  id             String   @id @default(uuid()) @db.Uuid
  metricId       String   @db.Uuid
  dependsOnId    String   @db.Uuid
  createdAt      DateTime @default(now())

  metric    Metric @relation("MetricDependent", fields: [metricId], references: [id], onDelete: Cascade)
  dependsOn Metric @relation("MetricDependsOn", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([metricId, dependsOnId])
  @@map("metric_dependencies")
}

enum PeriodType {
  DAY
  WEEK
  MONTH
  QUARTER
  YEAR
}

model MetricValue {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  metricId       String          @db.Uuid
  branchId       String?         @db.Uuid
  departmentId   String?         @db.Uuid
  periodType     PeriodType
  periodStart    DateTime        @db.Date
  periodEnd      DateTime        @db.Date
  value          Decimal         @db.Decimal(20, 6)
  /// Where the number came from: import id, manual entry, or calculation.
  sourceType     String          @default("MANUAL")
  sourceRef      String?
  /// Calculated values are derived server-side from a formula.
  isCalculated   Boolean         @default(false)
  calculatedAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric       Metric       @relation(fields: [metricId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metricId, branchId, departmentId, periodType, periodStart])
  @@index([organizationId, metricId, periodStart])
  @@index([organizationId, periodStart])
  @@map("metric_values")
}

model MetricTarget {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  metricId       String     @db.Uuid
  branchId       String?    @db.Uuid
  periodType     PeriodType
  periodStart    DateTime   @db.Date
  periodEnd      DateTime   @db.Date
  targetValue    Decimal    @db.Decimal(20, 6)
  /// Used when direction = TARGET_RANGE.
  minValue       Decimal?   @db.Decimal(20, 6)
  maxValue       Decimal?   @db.Decimal(20, 6)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric       Metric       @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metricId, branchId, periodType, periodStart])
  @@index([organizationId, metricId])
  @@map("metric_targets")
}

model MetricThreshold {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  metricId          String   @db.Uuid
  warningValue      Decimal? @db.Decimal(20, 6)
  criticalValue     Decimal? @db.Decimal(20, 6)
  /// When true the threshold is expressed as % deviation from target instead of absolute.
  isRelativeToTarget Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric       Metric       @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metricId])
  @@map("metric_thresholds")
}

// ---------------------------------------------------------------------------
// 8.5 Industry packs
// ---------------------------------------------------------------------------

model IndustryPack {
  id          String   @id @default(uuid()) @db.Uuid
  industryId  String   @db.Uuid
  code        String   @unique
  name        String
  version     String   @default("1.0.0")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  industry      Industry                   @relation(fields: [industryId], references: [id], onDelete: Cascade)
  packMetrics   IndustryPackMetric[]
  healthModels  IndustryPackHealthModel[]
  insightRules  IndustryPackInsightRule[]
  installations OrganizationIndustryPack[]

  @@map("industry_packs")
}

model IndustryPackMetric {
  id             String   @id @default(uuid()) @db.Uuid
  industryPackId String   @db.Uuid
  /// Template metric (organizationId is null) cloned into an organization on install.
  metricId       String   @db.Uuid
  isDefault      Boolean  @default(true)
  displayOrder   Int      @default(0)

  industryPack IndustryPack @relation(fields: [industryPackId], references: [id], onDelete: Cascade)
  metric       Metric       @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([industryPackId, metricId])
  @@map("industry_pack_metrics")
}

model IndustryPackHealthModel {
  id             String   @id @default(uuid()) @db.Uuid
  industryPackId String   @db.Uuid
  name           String
  /// Category + weight + metric weight definition, applied on install.
  definition     Json
  createdAt      DateTime @default(now())

  industryPack IndustryPack @relation(fields: [industryPackId], references: [id], onDelete: Cascade)

  @@map("industry_pack_health_models")
}

model IndustryPackInsightRule {
  id             String   @id @default(uuid()) @db.Uuid
  industryPackId String   @db.Uuid
  code           String
  name           String
  /// Deterministic rule definition (conditions + message template + evidence metrics).
  definition     Json
  createdAt      DateTime @default(now())

  industryPack IndustryPack @relation(fields: [industryPackId], references: [id], onDelete: Cascade)

  @@unique([industryPackId, code])
  @@map("industry_pack_insight_rules")
}

model OrganizationIndustryPack {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  industryPackId String   @db.Uuid
  version        String
  installedAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  industryPack IndustryPack @relation(fields: [industryPackId], references: [id], onDelete: Cascade)

  @@unique([organizationId, industryPackId])
  @@map("organization_industry_packs")
}

// ---------------------------------------------------------------------------
// 8.6 Health
// ---------------------------------------------------------------------------

model HealthModel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  isActive       Boolean  @default(true)
  /// Configurable band labels/ranges (defaults in @sip/shared-types).
  bands          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories   HealthCategory[]
  scores       HealthScore[]

  @@index([organizationId, isActive])
  @@map("health_models")
}

model HealthCategory {
  id            String   @id @default(uuid()) @db.Uuid
  healthModelId String   @db.Uuid
  name          String
  code          String
  /// Percentage of the overall score, 0-100. Categories must sum to 100.
  weight        Decimal  @db.Decimal(6, 3)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())

  healthModel HealthModel          @relation(fields: [healthModelId], references: [id], onDelete: Cascade)
  weights     HealthMetricWeight[]

  @@unique([healthModelId, code])
  @@map("health_categories")
}

model HealthMetricWeight {
  id               String  @id @default(uuid()) @db.Uuid
  healthCategoryId String  @db.Uuid
  metricId         String  @db.Uuid
  /// Percentage inside the category, 0-100. Metrics in a category must sum to 100.
  weight           Decimal @db.Decimal(6, 3)

  healthCategory HealthCategory @relation(fields: [healthCategoryId], references: [id], onDelete: Cascade)
  metric         Metric         @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([healthCategoryId, metricId])
  @@map("health_metric_weights")
}

model HealthScore {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  healthModelId  String     @db.Uuid
  branchId       String?    @db.Uuid
  periodType     PeriodType
  periodStart    DateTime   @db.Date
  periodEnd      DateTime   @db.Date
  overallScore   Decimal    @db.Decimal(6, 3)
  band           String
  /// Per-category breakdown with the contributing metric scores (evidence).
  breakdown      Json
  calculatedAt   DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  healthModel  HealthModel  @relation(fields: [healthModelId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([organizationId, healthModelId, branchId, periodType, periodStart])
  @@index([organizationId, periodStart])
  @@map("health_scores")
}

// ---------------------------------------------------------------------------
// 8.7 Alerts
// ---------------------------------------------------------------------------

enum AlertSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum AlertRuleType {
  METRIC_BELOW_THRESHOLD
  METRIC_ABOVE_THRESHOLD
  LARGE_PERIOD_CHANGE
  TARGET_MISSED
  DATA_SOURCE_STALE
  DATA_QUALITY_DEGRADED
}

model AlertRule {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  metricId       String?       @db.Uuid
  /// Stable identifier within the organization, so an industry pack can install
  /// its rules idempotently and an upgrade can find what it installed before.
  code           String
  name           String
  description    String?
  type           AlertRuleType
  severity       AlertSeverity @default(WARNING)
  /// Rule parameters, e.g. { "changePct": -10 } or { "staleDays": 7 }.
  definition     Json
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric       Metric?      @relation(fields: [metricId], references: [id], onDelete: Cascade)
  alerts       Alert[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("alert_rules")
}

model Alert {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  alertRuleId    String?       @db.Uuid
  metricId       String?       @db.Uuid
  severity       AlertSeverity
  status         AlertStatus   @default(OPEN)
  title          String
  description    String
  periodType     PeriodType?
  periodStart    DateTime?     @db.Date
  /// The numbers that triggered the alert — every alert must explain itself.
  evidence       Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alertRule    AlertRule?   @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)
  metric       Metric?      @relation(fields: [metricId], references: [id], onDelete: SetNull)
  events       AlertEvent[]
  decisionLinks DecisionAlert[]

  @@index([organizationId, status, severity])
  @@index([organizationId, createdAt])
  @@map("alerts")
}

model AlertEvent {
  id         String       @id @default(uuid()) @db.Uuid
  alertId    String       @db.Uuid
  actorId    String?      @db.Uuid
  fromStatus AlertStatus?
  toStatus   AlertStatus
  note       String?
  createdAt  DateTime     @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@map("alert_events")
}

// ---------------------------------------------------------------------------
// 8.8 Insights
// ---------------------------------------------------------------------------

model InsightRule {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  name           String
  description    String?
  /// Deterministic condition set — insights are rule-generated, never AI-generated.
  definition     Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  insights     Insight[]

  @@unique([organizationId, code])
  @@map("insight_rules")
}

model Insight {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  insightRuleId  String?    @db.Uuid
  title          String
  narrative      String
  category       String?
  severity       AlertSeverity @default(INFO)
  periodType     PeriodType?
  periodStart    DateTime?  @db.Date
  createdAt      DateTime   @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  insightRule  InsightRule?      @relation(fields: [insightRuleId], references: [id], onDelete: SetNull)
  evidence     InsightEvidence[]
  decisionLinks DecisionInsight[]

  @@index([organizationId, createdAt])
  @@map("insights")
}

model InsightEvidence {
  id        String   @id @default(uuid()) @db.Uuid
  insightId String   @db.Uuid
  metricId  String?  @db.Uuid
  label     String
  value     Decimal? @db.Decimal(20, 6)
  changePct Decimal? @db.Decimal(12, 4)
  detail    Json?

  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@index([insightId])
  @@map("insight_evidence")
}

// ---------------------------------------------------------------------------
// 8.9 Goals
// ---------------------------------------------------------------------------

enum GoalStatus {
  DRAFT
  ACTIVE
  ON_TRACK
  AT_RISK
  OFF_TRACK
  ACHIEVED
  CANCELLED
}

model Goal {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  title          String
  description    String?
  ownerId        String?    @db.Uuid
  baselineValue  Decimal?   @db.Decimal(20, 6)
  targetValue    Decimal    @db.Decimal(20, 6)
  currentValue   Decimal?   @db.Decimal(20, 6)
  progressPct    Decimal?   @db.Decimal(6, 2)
  startDate      DateTime   @db.Date
  dueDate        DateTime   @db.Date
  status         GoalStatus @default(DRAFT)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?         @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  metrics      GoalMetric[]
  updates      GoalUpdate[]
  decisionLinks DecisionGoal[]

  @@index([organizationId, status])
  @@map("goals")
}

model GoalMetric {
  id       String  @id @default(uuid()) @db.Uuid
  goalId   String  @db.Uuid
  metricId String  @db.Uuid
  /// Primary metric drives automatic progress calculation.
  isPrimary Boolean @default(true)

  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  metric Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([goalId, metricId])
  @@map("goal_metrics")
}

model GoalUpdate {
  id           String      @id @default(uuid()) @db.Uuid
  goalId       String      @db.Uuid
  actorId      String?     @db.Uuid
  currentValue Decimal?    @db.Decimal(20, 6)
  progressPct  Decimal?    @db.Decimal(6, 2)
  status       GoalStatus?
  note         String?
  createdAt    DateTime    @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@map("goal_updates")
}

// ---------------------------------------------------------------------------
// 8.10 Decisions
// ---------------------------------------------------------------------------

enum DecisionStatus {
  DRAFT
  OPEN
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DecisionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DecisionReviewResult {
  POSITIVE
  NEUTRAL
  NEGATIVE
  INCONCLUSIVE
}

model Decision {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  title            String
  problemStatement String
  context          String?
  ownerId          String?          @db.Uuid
  status           DecisionStatus   @default(DRAFT)
  priority         DecisionPriority @default(MEDIUM)
  decisionDate     DateTime?        @db.Date
  expectedOutcome  String?
  reviewDate       DateTime?        @db.Date
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?             @relation("DecisionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  actions      DecisionAction[]
  metrics      DecisionMetric[]
  alerts       DecisionAlert[]
  insights     DecisionInsight[]
  goals        DecisionGoal[]
  reviews      DecisionReview[]

  @@index([organizationId, status, priority])
  @@map("decisions")
}

model DecisionAction {
  id          String    @id @default(uuid()) @db.Uuid
  decisionId  String    @db.Uuid
  title       String
  description String?
  ownerId     String?   @db.Uuid
  dueDate     DateTime? @db.Date
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@map("decision_actions")
}

model DecisionMetric {
  id         String @id @default(uuid()) @db.Uuid
  decisionId String @db.Uuid
  metricId   String @db.Uuid

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  metric   Metric   @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([decisionId, metricId])
  @@map("decision_metrics")
}

model DecisionAlert {
  id         String @id @default(uuid()) @db.Uuid
  decisionId String @db.Uuid
  alertId    String @db.Uuid

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  alert    Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([decisionId, alertId])
  @@map("decision_alerts")
}

model DecisionInsight {
  id         String @id @default(uuid()) @db.Uuid
  decisionId String @db.Uuid
  insightId  String @db.Uuid

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  insight  Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@unique([decisionId, insightId])
  @@map("decision_insights")
}

model DecisionGoal {
  id         String @id @default(uuid()) @db.Uuid
  decisionId String @db.Uuid
  goalId     String @db.Uuid

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  goal     Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([decisionId, goalId])
  @@map("decision_goals")
}

model DecisionReview {
  id              String                @id @default(uuid()) @db.Uuid
  decisionId      String                @db.Uuid
  reviewerId      String?               @db.Uuid
  expectedOutcome String?
  actualOutcome   String?
  result          DecisionReviewResult?
  notes           String?
  reviewedAt      DateTime              @default(now())

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@map("decision_reviews")
}

// ---------------------------------------------------------------------------
// 8.11 AI
// ---------------------------------------------------------------------------

enum AiMessageRole {
  USER
  ASSISTANT
}

model AiConversation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AiMessage[]
  queries      AiQuery[]

  @@index([organizationId, userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  role           AiMessageRole
  content        String
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiQuery {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  question       String
  /// The verified analytics context handed to the model — no raw provider internals.
  contextSummary Json
  model          String?
  latencyMs      Int?
  tokensPrompt   Int?
  tokensOutput   Int?
  errorCode      String?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_queries")
}

// ---------------------------------------------------------------------------
// 8.12 Governance
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  actorId        String?  @db.Uuid
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model OrganizationSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String
  value          Json
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("organization_settings")
}

model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}
