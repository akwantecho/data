# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Local development against docker-compose (see docker-compose.yml)
DATABASE_URL=postgresql://sip:sip_dev_password@localhost:5432/strategic_intelligence?schema=public

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Requests per minute per IP. Authentication endpoints are tighter still.
RATE_LIMIT=120
# Only integration tests set this to false; it must stay true in production.
THROTTLE_ENABLED=true

LOG_LEVEL=log

# Session signing secrets — generate your own with: openssl rand -base64 48
# The two values must differ, and both must be at least 32 characters.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-development-secret-1
JWT_REFRESH_SECRET=replace-me-with-a-long-random-development-secret-2
# Access token lifetime in seconds (15 minutes)
JWT_ACCESS_TTL=900
# Refresh token lifetime in seconds (7 days)
JWT_REFRESH_TTL=604800

# Session cookies. Must be true anywhere that is not local HTTP development.
COOKIE_SECURE=false
# COOKIE_DOMAIN=example.com

# Password for the accounts created by `pnpm db:seed` (development only)
# SEED_PASSWORD=Password123!
